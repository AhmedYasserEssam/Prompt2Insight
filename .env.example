APP_ENV=development
APP_NAME=Prompt2Insight
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
MOCK_MODE=true

APP_DATABASE_URL=postgresql+asyncpg://prompt2insight:prompt2insight@app-db:5432/prompt2insight

LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=replace-this-in-production
LITELLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=

SQL_PLANNER_PRIMARY_MODEL=groq/qwen/qwen3.6-27b
SQL_PLANNER_FALLBACK_MODEL=groq/openai/gpt-oss-20b
ANSWER_PRIMARY_MODEL=answer-primary
ANSWER_FALLBACK_MODEL=answer-fallback
LITELLM_ANSWER_PRIMARY_MODEL=groq/qwen/qwen3.6-27b
LITELLM_ANSWER_FALLBACK_MODEL=groq/openai/gpt-oss-20b

# Optional local vLLM provider; leave disabled for normal development.
VLLM_ENABLED=false
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_TIMEOUT_SECONDS=60

QUERY_TIMEOUT_MS=8000
LOCK_TIMEOUT_MS=2000
MAX_OUTPUT_ROWS=1000
MAX_JOINS=6
MAX_ESTIMATED_ROWS=100000
MAX_QUERY_COST=100000
