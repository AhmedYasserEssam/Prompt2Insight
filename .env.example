APP_ENV=development
APP_NAME=Prompt2Insight
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
MOCK_MODE=true

APP_DATABASE_URL=postgresql+asyncpg://prompt2insight:prompt2insight@app-db:5432/prompt2insight

LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=replace-this-in-production

SQL_PLANNER_PRIMARY_MODEL=openai/replace-primary-planner-model
SQL_PLANNER_FALLBACK_MODEL=anthropic/replace-fallback-planner-model
ANSWER_PRIMARY_MODEL=openai/replace-primary-answer-model
ANSWER_FALLBACK_MODEL=anthropic/replace-fallback-answer-model

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

QUERY_TIMEOUT_MS=8000
LOCK_TIMEOUT_MS=2000
MAX_OUTPUT_ROWS=1000
MAX_JOINS=6
MAX_ESTIMATED_ROWS=100000
MAX_QUERY_COST=100000
